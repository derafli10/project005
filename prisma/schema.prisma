// file: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CookedTier {
  MAIN_CHARACTER
  LET_HIM_COOK
  SLIGHTLY_COOKED
  OVERCOOKED
}

enum PostTag {
  CURHAT_TUGAS
  BUTUH_TEMAN_TIM
  TANYA_JAWABAN
  DISKUSI_UMUM
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum DigestChannel {
  EMAIL
  TELEGRAM
}

enum Locale {
  EN
  ID
}

// ─── AUTH.JS REQUIRED MODELS ────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  role            UserRole @default(MEMBER)
  locale          Locale   @default(EN)

  digestEnabled   Boolean  @default(false)
  digestTime      String?  // HH:MM format
  deliveryChannel DigestChannel @default(EMAIL)
  telegramChatId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Auth.js relations
  accounts        Account[]
  sessions        Session[]

  // Domain relations
  ownedClassRooms  ClassRoom[]        @relation("ClassRoomCreator")
  classMemberships ClassRoomMember[]
  createdTasks     Task[]             @relation("TaskCreator")
  taskProgress     UserTaskProgress[]
  taskOverrides    TaskOverride[]
  taskEditLogs     TaskEditLog[]
  taskEditLogReads TaskEditLogRead[]
  cookedScores     CookedScore[]
  digestLogs       DailyDigestLog[]
  academicWrapped  AcademicWrapped[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── DOMAIN MODELS ──────────────────────────────────────────────────────────

model ClassRoom {
  id        String   @id @default(cuid())
  className String   @db.VarChar(120)
  classCode String   @unique @db.VarChar(8)
  sksWeight Int      @default(3) // Scale 1-5 integer (Bobot SKS Mata Kuliah)
  creatorId String
  createdAt DateTime @default(now())

  creator     User              @relation("ClassRoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  memberships ClassRoomMember[]
  tasks       Task[]
  posts       AnonymousPost[]

  @@index([classCode])
  @@index([creatorId])
}

model ClassRoomMember {
  classRoomId String
  userId      String
  joinedAt    DateTime @default(now())

  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classRoomId, userId])
  @@index([classRoomId])
  @@index([userId])
}

model Task {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  sksWeight     Int      @default(3)
  taskWeight    Int      @default(5000) // Basis points 0-10000
  deadlineAt    DateTime
  isSubTask     Boolean  @default(false)
  parentTaskId  String?
  classRoomId   String?
  creatorId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentTask    Task?    @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks      Task[]   @relation("SubTasks")
  classRoom     ClassRoom? @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  creator       User     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  userProgress  UserTaskProgress[]
  overrides     TaskOverride[]
  editLogs      TaskEditLog[]

  @@index([classRoomId])
  @@index([creatorId])
  @@index([deadlineAt])
  @@index([parentTaskId])
}

model UserTaskProgress {
  userId             String
  taskId             String
  status             TaskStatus @default(PENDING)
  position           Int?
  completedAt        DateTime?
  currentStressScore Int        @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([userId, status])
}

model TaskOverride {
  id           String   @id @default(cuid())
  userId       String
  taskId       String
  reason       String   @db.Text
  overriddenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([overriddenAt])
}

model TaskEditLog {
  id        String   @id @default(cuid())
  taskId    String
  editorId  String
  fieldName String   @db.VarChar(64)
  oldValue  String   @db.Text
  newValue  String   @db.Text
  editedAt  DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  editor User @relation(fields: [editorId], references: [id], onDelete: Cascade)

  readStates TaskEditLogRead[]

  @@index([taskId])
  @@index([editorId])
}

model TaskEditLogRead {
  logId    String
  userId   String
  isRead   Boolean  @default(false)

  log      TaskEditLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([logId, userId])
  @@index([logId])
  @@index([userId])
  @@index([userId, isRead])
}

model CookedScore {
  id              String     @id @default(cuid())
  userId          String
  date            DateTime   @db.Date
  cumulativeScore Int        @default(0) // 0-10000+ basis points
  tier            CookedTier @default(MAIN_CHARACTER)
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model AnonymousPost {
  id                String   @id @default(cuid())
  classRoomId       String
  encryptedAuthorId String   @db.Text
  content           String   @db.VarChar(500)
  tag               PostTag
  createdAt         DateTime @default(now())

  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)

  @@index([classRoomId])
  @@index([classRoomId, tag])
  @@index([classRoomId, createdAt])
}

model DailyDigestLog {
  id             String         @id @default(cuid())
  userId         String
  digestDate     DateTime       @db.Date
  deliveryStatus DeliveryStatus
  errorMessage   String?        @db.Text
  sentAt         DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate])
  @@index([userId])
  @@index([userId, digestDate])
}

model AcademicWrapped {
  id                String     @id @default(cuid())
  userId            String
  weekStartDate     DateTime   @db.Date  // Monday 00:00 of target week
  weekEndDate       DateTime   @db.Date  // Sunday 23:59 of target week
  totalSavedCredits Int        @default(0) // SUM(taskWeight) for COMPLETED tasks in basis points
  tasksCompleted    Int        @default(0) // Count of COMPLETED tasks in the week
  highestTier       CookedTier @default(MAIN_CHARACTER) // Max tier reached during week
  streak            Int        @default(0) // Consecutive days with ≥1 completed task
  imageUrl          String?    @db.Text   // CDN URL of generated 1080x1920 PNG card
  generatedAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId])
  @@index([userId, weekStartDate])
}
